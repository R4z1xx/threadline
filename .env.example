# threadline :: environment template
# Copy to .env is done automatically by lib/core_bootstrap.sh on first run.
# You normally do NOT need to edit this by hand — bootstrap fills in secrets.
# It's kept here so you can see (and override, before first run) what's configurable.

# ---- Graylog ----
GRAYLOG_HTTP_EXTERNAL_URI=http://CHANGE-ME:9000/
GRAYLOG_ROOT_PASSWORD=                 # plaintext, generated on first run — this is what you log in with
GRAYLOG_ROOT_PASSWORD_SHA2=            # sha256 of the above, generated automatically
GRAYLOG_PASSWORD_SECRET=               # 96-char random secret, generated automatically
OPENSEARCH_HEAP=1g                     # raise if your VM has more than ~4GB RAM

# ---- MISP (values passed through to the official misp-docker .env) ----
MISP_BASE_URL=https://CHANGE-ME
MISP_ADMIN_EMAIL=admin@lab.lan
MISP_ADMIN_PASSWORD=                   # generated on first run
MISP_MYSQL_ROOT_PASSWORD=              # generated on first run
MISP_MYSQL_PASSWORD=                   # generated on first run
MISP_REDIS_PASSWORD=                   # generated on first run
MISP_GPG_PASSPHRASE=                   # generated on first run

# Fill this in AFTER first login to MISP (Administration > List Auth Keys > Add
# authentication key), then re-run: sudo ./run.sh --role=core --link-misp
# This wires the key into Graylog's MISP lookup table automatically, AND
# enables/fetches the feeds below.
MISP_API_KEY=

# Comma-separated, case-insensitive substrings matched against MISP's ~50
# bundled default feed names (loaded via `Server loadDefaultFeeds`). Any
# feed whose name contains one of these gets enabled automatically.
MISP_ENABLE_FEEDS=CIRCL OSINT Feed,abuse.ch,Botvrij.eu,blocklist.de,Tor ALL,VXvault

# Feeds NOT in MISP's bundled catalog, added directly via the API. One
# entry per ';'-separated block: name|url|header_name:header_value
# (the header part is optional, omit it for feeds that don't need auth).
#
# Rösti (https://rosti.dev) is a good example -- it's NOT reliably usable
# via MISP's own bundled default-feed entry (that entry points at an old,
# possibly dead domain from before Rösti's migration to rosti.dev, and
# Rösti is moving to required API-key auth on Oct 1, 2026). Sign up at
# rosti.dev, grab your API key, confirm the current MISP-format feed path
# from their docs (docs.rosti.dev), then fill in below, e.g.:
#
# MISP_CUSTOM_FEEDS=Rosti|https://rosti.dev/downloads/misp/|X-Api-Key:your-key-here
MISP_CUSTOM_FEEDS=
